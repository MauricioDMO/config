# ==============================================================================
# Archivo de configuración de i3wm
# Reorganizado por secciones claras para facilitar el mantenimiento.

# ------------------------------------------------------------------------------
# 1. VARIABLES Y CONFIGURACIÓN BÁSICA
# ------------------------------------------------------------------------------
# Tecla maestra (Mod4 = Tecla Windows/Super)
set $mod Mod4

# Workspace dedicado para YouTube Music
set $wsMusic "M"
set $notMusic [con_id="__focused__" workspace="^(?!M$).*"]

# Fuente del sistema para ventanas y barra
font pango:JetBrains Mono 10

# ------------------------------------------------------------------------------
# 2. APLICACIONES Y LANZADORES
# ------------------------------------------------------------------------------
# Terminal (Ghostty)
bindsym $mod+Return exec --no-startup-id ~/.config/i3/scripts/open-terminal-here.sh

# Menú de aplicaciones (Rofi)
bindsym $mod+g exec rofi -show drun -theme ~/.config/config/deb/rofi/theme.rasi

# Selector de ventanas (Rofi)
bindsym $mod+Shift+g exec rofi -show window -theme ~/.config/config/deb/rofi/theme.rasi

# Navegador Web (Brave)
bindsym $mod+Shift+Return exec brave-origin-nightly

# Editor de Código (VS Code)
bindsym $mod+c exec code

# Notas (Obsidian)
bindsym $mod+q exec --no-startup-id obsidian

# YouTube Music
bindsym $mod+m exec --no-startup-id ~/.config/i3/scripts/open-music.sh
assign [class="^com[.]github[.]th-ch[.]youtube-music$"] workspace $wsMusic

# Administrador de archivos (Dolphin)
bindsym $mod+x exec --no-startup-id dolphin

# Administrador de tareas
bindsym $mod+Shift+Escape exec --no-startup-id /usr/bin/flatpak run io.missioncenter.MissionCenter

# Calculadora (SpeedCrunch)
bindsym XF86Calculator exec --no-startup-id speedcrunch

# Historial de Portapapeles (XFCE Clipman)
bindsym $mod+Shift+v exec --no-startup-id copyq menu
bindsym $mod+Ctrl+Shift+v exec --no-startup-id copyq toggle

# ------------------------------------------------------------------------------
# 3. CONTROL DEL SISTEMA Y GESTIÓN DE i3
# ------------------------------------------------------------------------------
# Recargar configuración de i3 (sin reiniciar X)
bindsym $mod+Shift+c reload

# Reiniciar i3 (para actualizaciones de versión, etc.)
bindsym $mod+Shift+r restart

# Cerrar ventana actual (Kill)
bindsym $mod+Shift+q kill

# Bloquear pantalla (i3lock)
bindsym $mod+Shift+x exec i3lock -c 111111

# ------------------------------------------------------------------------------
# 4. CONTROLES DE HARDWARE (Audio, Brillo, Capturas)
# ------------------------------------------------------------------------------
# --- Audio (PulseAudio / Pactl) ---
bindsym XF86AudioRaiseVolume exec --no-startup-id sh -c 'pactl set-sink-mute @DEFAULT_SINK@ 0 && pactl set-sink-volume @DEFAULT_SINK@ +2% && pkill -RTMIN+1 i3blocks'
bindsym XF86AudioLowerVolume exec --no-startup-id sh -c 'pactl set-sink-mute @DEFAULT_SINK@ 0 && pactl set-sink-volume @DEFAULT_SINK@ -2% && pkill -RTMIN+1 i3blocks'
bindsym XF86AudioMute exec --no-startup-id sh -c 'pactl set-sink-mute @DEFAULT_SINK@ toggle && pkill -RTMIN+1 i3blocks'
bindsym $mod+Ctrl+v exec pavucontrol

# --- Control Multimedia (Playerctl) ---
bindsym XF86AudioPlay exec --no-startup-id playerctl --player=playerctld play-pause
bindsym XF86AudioPause exec --no-startup-id playerctl --player=playerctld play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl --player=playerctld next
bindsym XF86AudioPrev exec --no-startup-id playerctl --player=playerctld previous

# --- Brillo de Pantalla ---
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# --- Trackpad ---
bindsym $mod+t exec --no-startup-id ~/.config/i3/scripts/toggle-trackpad.sh
bindsym $mod+Shift+t exec --no-startup-id ~/.config/i3/scripts/toggle-pointer-accel.sh

# --- Capturas de Pantalla (Flameshot) ---
bindsym Print exec flameshot gui
bindsym $mod+Shift+s exec flameshot gui

# --- Idioma del Teclado ---
# Alternar entre US y Latam con Mod+Espacio. bindcode usa el keycode fijo de Space,
# para que siga funcionando aunque el teclado USB se reconecte con otro layout.
bindcode $mod+65 exec --no-startup-id ~/.config/i3/scripts/toggle-keyboard-layout.sh

# --- Teclas rotas ---
# Alternativas para escribir d, e y 3 cuando el teclado físico falla.
bindsym --release $mod+u exec --no-startup-id xdotool type --clearmodifiers d
bindsym --release $mod+i exec --no-startup-id xdotool type --clearmodifiers e
bindsym --release $mod+9 exec --no-startup-id xdotool type --clearmodifiers 3
bindsym --release $mod+Shift+u exec --no-startup-id xdotool type --clearmodifiers D
bindsym --release $mod+Shift+i exec --no-startup-id xdotool type --clearmodifiers E

# ------------------------------------------------------------------------------
# 5. NAVEGACIÓN DE VENTANAS (Foco)
# ------------------------------------------------------------------------------
# Mover foco con teclas hjkl (estilo Vim)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Mover foco con flechas
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# ------------------------------------------------------------------------------
# 6. MOVIMIENTO DE VENTANAS
# ------------------------------------------------------------------------------
# Mover ventana activa con Shift + hjkl
bindsym $mod+Shift+h $notMusic move left
bindsym $mod+Shift+j $notMusic move down
bindsym $mod+Shift+k $notMusic move up
bindsym $mod+Shift+l $notMusic move right

# Mover ventana activa con Shift + Flechas
bindsym $mod+Shift+Left $notMusic move left
bindsym $mod+Shift+Down $notMusic move down
bindsym $mod+Shift+Up $notMusic move up
bindsym $mod+Shift+Right $notMusic move right

# ------------------------------------------------------------------------------
# 7. DISEÑO Y MODIFICACIÓN DEL LAYOUT
# ------------------------------------------------------------------------------
# Dividir ventana (Split)
bindsym $mod+v split v
bindsym $mod+b split h

# Pantalla completa (Fullscreen)
bindsym $mod+f fullscreen toggle

# Flotante (Floating)
bindsym $mod+Shift+space floating toggle
# Mod + clic izquierdo y arrastre: mover ventanas flotantes
floating_modifier $mod
# Mod + clic central: alternar entre mosaico y flotante
bindsym --whole-window $mod+button2 floating toggle

# Tipos de Layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed        
bindsym $mod+e layout toggle split

# --- Redimensionar Ventanas ---
# Modo redimensionar: Mod + Alt + (hjkl / flechas)
bindsym $mod+Mod1+h resize shrink width 2 px or 2 ppt
bindsym $mod+Mod1+l resize grow   width 2 px or 2 ppt
bindsym $mod+Mod1+j resize grow   height 2 px or 2 ppt
bindsym $mod+Mod1+k resize shrink height 2 px or 2 ppt

bindsym $mod+Mod1+Left  resize shrink width 2 px or 2 ppt
bindsym $mod+Mod1+Right resize grow   width 2 px or 2 ppt
bindsym $mod+Mod1+Down  resize grow   height 2 px or 2 ppt
bindsym $mod+Mod1+Up    resize shrink height 2 px or 2 ppt

# ------------------------------------------------------------------------------
# 8. GESTIÓN DE WORKSPACES (Escritorios Virtuales)
# ------------------------------------------------------------------------------
# Definición de nombres de workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"

# Cambiar al workspace (Mod + Número)
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6

# Cambiar al workspace con numpad. bindcode evita problemas con NumLock/layout.
bindcode $mod+87 workspace $ws1
bindcode $mod+88 workspace $ws2
bindcode $mod+89 workspace $ws3
bindcode $mod+83 workspace $ws4
bindcode $mod+84 workspace $ws5
bindcode $mod+85 workspace $ws6

# Mover ventana al workspace (Mod + Shift + Número)
bindsym $mod+Shift+1 $notMusic move container to workspace $ws1
bindsym $mod+Shift+2 $notMusic move container to workspace $ws2
bindsym $mod+Shift+3 $notMusic move container to workspace $ws3
bindsym $mod+Shift+4 $notMusic move container to workspace $ws4
bindsym $mod+Shift+5 $notMusic move container to workspace $ws5
bindsym $mod+Shift+6 $notMusic move container to workspace $ws6

# Mover ventana al workspace con numpad
bindcode $mod+Shift+87 $notMusic move container to workspace $ws1
bindcode $mod+Shift+88 $notMusic move container to workspace $ws2
bindcode $mod+Shift+89 $notMusic move container to workspace $ws3
bindcode $mod+Shift+83 $notMusic move container to workspace $ws4
bindcode $mod+Shift+84 $notMusic move container to workspace $ws5
bindcode $mod+Shift+85 $notMusic move container to workspace $ws6

# Mover el workspace actual completo a otro número (Renombrar)
bindsym $mod+Ctrl+1 exec --no-startup-id ~/.config/i3/scripts/rename-workspace.sh $ws1
bindsym $mod+Ctrl+2 exec --no-startup-id ~/.config/i3/scripts/rename-workspace.sh $ws2
bindsym $mod+Ctrl+3 exec --no-startup-id ~/.config/i3/scripts/rename-workspace.sh $ws3
bindsym $mod+Ctrl+4 exec --no-startup-id ~/.config/i3/scripts/rename-workspace.sh $ws4
bindsym $mod+Ctrl+5 exec --no-startup-id ~/.config/i3/scripts/rename-workspace.sh $ws5
bindsym $mod+Ctrl+6 exec --no-startup-id ~/.config/i3/scripts/rename-workspace.sh $ws6

# Renombrar workspace con numpad
bindcode $mod+Ctrl+87 exec --no-startup-id ~/.config/i3/scripts/rename-workspace.sh $ws1
bindcode $mod+Ctrl+88 exec --no-startup-id ~/.config/i3/scripts/rename-workspace.sh $ws2
bindcode $mod+Ctrl+89 exec --no-startup-id ~/.config/i3/scripts/rename-workspace.sh $ws3
bindcode $mod+Ctrl+83 exec --no-startup-id ~/.config/i3/scripts/rename-workspace.sh $ws4
bindcode $mod+Ctrl+84 exec --no-startup-id ~/.config/i3/scripts/rename-workspace.sh $ws5
bindcode $mod+Ctrl+85 exec --no-startup-id ~/.config/i3/scripts/rename-workspace.sh $ws6

# Alternar entre workspace actual y el anterior
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+Shift+Tab $notMusic move container to workspace back_and_forth

# ------------------------------------------------------------------------------
# 9. GESTIÓN MULTI-MONITOR
# ------------------------------------------------------------------------------
# Cambiar foco a la siguiente pantalla
bindsym $mod+o focus output next

# Mover ventana a la siguiente pantalla
bindsym $mod+Shift+o $notMusic move container to output next

# Mover workspace completo a la siguiente pantalla
bindsym $mod+Control+o move workspace to output next

# ------------------------------------------------------------------------------
# 10. ESTÉTICA Y COLORES
# ------------------------------------------------------------------------------
# Forzar bordes para que se vea el foco

# Ghostty
for_window [class="com.mitchellh.ghostty"] border pixel 2
# VS Code
for_window [class="code"] border pixel 2
# CopyQ: mostrar la ventana principal como flotante
for_window [class="copyq" window_role="main"] floating enable

# Quitar barra de título en modo split, pero mantenerla en tabbed/stacking
# Nota: i3 no permite ocultar títulos basado puramente en el layout dinámico de forma nativa simple,
# pero "border pixel" oculta el título. Para mantener títulos en stack/tabbed:
default_border pixel 2
default_floating_border normal
hide_edge_borders smart

# Colores de las ventanas
# class                 border  backgr. text    indicator child_border
client.focused          #2E6F40 #2E6F40 #ffffff #2E6F40   #2E6F40
client.unfocused        #333333 #222222 #bbbbbb #444444   #222222
client.focused_inactive #444444 #333333 #dddddd #555555   #333333
client.urgent           #ff0000 #ff0000 #ffffff #ff0000   #ff0000

# ------------------------------------------------------------------------------
# 11. BARRA DE ESTADO (i3bar)
# ------------------------------------------------------------------------------
bar {
    status_command i3blocks -c ~/.config/i3blocks/config
    tray_output primary

    colors {
        background #111111
        statusline #ffffff
        separator  #444444

        # Colores de los workspaces en la barra
        #                    border  backgr. text
        focused_workspace    #2E6F40 #2E6F40 #ffffff
        active_workspace     #444444 #444444 #ffffff
        inactive_workspace   #222222 #222222 #bbbbbb
        urgent_workspace     #ff0000 #ff0000 #ffffff
        binding_mode         #2E6F40 #2E6F40 #ffffff
    }
}

# ------------------------------------------------------------------------------
# 12. AUTOSTART (Inicio Automático)
# ------------------------------------------------------------------------------
# Servicios esenciales del entorno de escritorio
exec --no-startup-id xfsettingsd
exec --no-startup-id xfce4-power-manager
exec --no-startup-id nm-applet
exec --no-startup-id dunst
exec --no-startup-id picom
exec --no-startup-id lxpolkit
exec --no-startup-id playerctld daemon

# Bloqueo de pantalla automático
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -n -c 111111

# --- Scripts y configuraciones persistentes (exec_always) ---
# Iniciar CopyQ al arrancar (con delay solo en primer login)
exec_always --no-startup-id sh -c 'if [ ! -f /tmp/i3-startup-copyq ]; then sleep 3; touch /tmp/i3-startup-copyq; fi && pgrep -x copyq >/dev/null || copyq'

# Configuración de monitores (si existe el script)
exec_always --no-startup-id sh -c '[ -x "$HOME/.screenlayout/dock.sh" ] && "$HOME/.screenlayout/dock.sh" || true'

# Fondo de pantalla aleatorio (si hay imágenes en ~/core/config/bg/)
# Con delay solo en primer login
exec_always --no-startup-id sh -c 'bg_dir="$HOME/core/config/bg"; [ -d "$bg_dir" ] || exit 0; if [ ! -f /tmp/i3-startup-bg ]; then sleep 1.5; touch /tmp/i3-startup-bg; fi; img=$(find "$bg_dir" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | shuf -n 1); [ -n "$img" ] && feh --bg-fill "$img"'

# Configuración de periféricos (scroll natural solo para Touchpad)
exec_always --no-startup-id sh -c 'xinput set-prop "VEN_27C6:00 27C6:0D43 Touchpad" "libinput Natural Scrolling Enabled" 1 2>/dev/null || true'
exec_always --no-startup-id sh -c 'xinput set-prop "VEN_27C6:00 27C6:0D43 Touchpad" "libinput Tapping Enabled" 1 >/dev/null || true'
exec_always --no-startup-id sh -c 'xinput set-prop "VEN_27C6:00 27C6:0D43 Touchpad" "libinput Scroll Method Enabled" 1 0 0 2>/dev/null || true'
exec_always --no-startup-id sh -c 'xinput set-prop "PS/2 Generic Mouse" "libinput Natural Scrolling Enabled" 0 2>/dev/null || true'

# Iniciar en US; el binding de i3 alterna entre US y Latam.
exec_always --no-startup-id setxkbmap -option "" -layout "us"
